{
  "name": "fixel-erp",
  "version": "1.0.0",
  "private": true,
  "description": "FIXEL — نظام متكامل لإدارة محلات بيع وصيانة الأجهزة الإلكترونية",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:deploy": "prisma migrate deploy",
    "db:sqlite": "node scripts/switch-db.mjs sqlite",
    "db:mysql": "node scripts/switch-db.mjs mysql",
    "db:postgres": "node scripts/switch-db.mjs postgresql",
    "build:cpanel": "node scripts/build-standalone.mjs",
    "setup": "prisma generate && prisma db push && npm run db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "bidi-js": "^1.0.3",
    "bwip-js": "4.5.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "jose": "5.9.6",
    "lucide-react": "0.462.0",
    "next": "15.5.22",
    "pdfkit": "^0.19.1",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.0",
    "tailwind-merge": "2.5.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
